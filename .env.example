# Sviluppo locale: SQLite viene usato quando DATABASE_URL non è impostato.
WALLET_ENV=local
WALLET_DEBUG=1
WALLET_SECRET_KEY=sostituisci-con-una-chiave-casuale-locale
# In produzione indica il nome utente del superuser autorizzato.
WALLET_OWNER_USERNAME=
WALLET_ALLOWED_HOSTS=127.0.0.1,localhost
WALLET_CSRF_TRUSTED_ORIGINS=

# Database SQLite alternativo; il percorso predefinito è wallet.sqlite3.
# WALLET_DB_PATH=/percorso/assoluto/wallet-test.sqlite3
# Il file .env non viene caricato automaticamente: esporta le variabili nel terminale
# oppure configurale nell’ambiente del tuo servizio.

# Per PostgreSQL locale o produzione puoi impostare DATABASE_URL.
# Su Northflank collega POSTGRES_URI a DATABASE_URL tramite un Secret Group.
# DATABASE_URL=postgresql://utente:password@host:5432/database
